{
  "name": "deepscord",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/An1X3R/deepscord.git"
  },
  "description": "Deepscord — 语音频道（Discord-like voice + text chat，网页 + Windows 桌面客户端）",
  "main": "server.js",
  "scripts": {
    "vendor:radio": "node tools/vendor-radio.cjs",
    "test:radio": "node --test test/radio-metadata.mjs && node test/radio-playback.cjs",
    "test:customization": "node --test test/server-governance.mjs test/interaction-scene.mjs test/interaction-catalog-server.mjs && node test/interaction-management-ui.mjs && node test/interaction-session.mjs && node test/interaction-ui.mjs && node test/interaction-renderer.mjs && node test/interaction-thumbnail-queue.mjs",
    "test:interaction": "node --test test/interaction-scene.mjs && node test/interaction-session.mjs && node test/interaction-ui.mjs && node test/interaction-renderer.mjs",
    "test:interaction-audio": "node --test test/interaction-audio-preferences.mjs && node test/interaction-audio.cjs",
    "test:poke": "node test/poke-session.mjs && node test/poke-visual.mjs",
    "test:poke-audio": "node test/poke-audio.cjs",
    "test:poke-overlay": "node desktop/test-poke-overlay.cjs",
    "start": "node server.js",
    "test": "node test/e2e.mjs",
    "test:ci": "node test/ci-suite.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:auth": "node test/auth.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:ui": "node test/ui.mjs",
    "test:deploy": "node test/deploy-check.mjs",
    "desktop:sync": "node tools/sync-appserver.cjs",
    "desktop:deps": "npm --prefix desktop ci --omit=dev --ignore-scripts",
    "desktop:dev": "npm run desktop:deps && npm run desktop:sync && npm run desktop:native && npm run desktop:screen-native && electron desktop",
    "desktop:build": "node tools/build-desktop.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --project tsconfig.network.json",
    "test:network": "node --test test/network-policy.mjs test/session-identity.mjs test/network-session.mjs test/direct-host.mjs",
    "test:app-network": "node test/app-network.cjs",
    "test:media": "node test/run-peer-media.cjs",
    "test:desktop-split": "node test/desktop-independent-server.mjs",
    "test:steam": "node --test test/steam-wire.mjs test/steam-commands.mjs test/steam-admission.mjs",
    "test:security": "node --test --test-concurrency=1 test/server-trust.mjs test/steam-admission.mjs",
    "test:security-native": "node test/desktop-security-native.mjs",
    "test:steam-native": "node test/steam-native-smoke.cjs",
    "test:steam-transition": "node test/steam-transition-native.cjs",
    "test:steam-state": "node --test test/steam-state.mjs test/steam-continuity.mjs test/steam-backend.mjs",
    "test:steam-authority": "node test/steam-authority-native.cjs",
    "test:steam-host": "node test/steam-host-native.mjs",
    "test:screen-diagnostics": "node test/screen-diagnostics.cjs",
    "test:steam-desktop": "node test/steam-room-native.mjs",
    "server:build": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools/build-server.ps1",
    "test:audio": "node --test test/peer-stats.mjs && node test/audio-capture.cjs && node test/voice-cadence.cjs",
    "desktop:native": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools/build-process-audio.ps1 && powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools/build-global-ptt.ps1 && powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools/build-windows-protection.ps1 && powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools/build-poke-window-bounds.ps1",
    "test:global-ptt": "node test/global-ptt.cjs",
    "test:chat-unread": "node --test test/chat-unread.mjs test/chat-unread-store.mjs",
    "test:chat-unread-ui": "node test/chat-unread-ui.mjs",
    "test:chat-unread-native": "node test/chat-unread-native.mjs",
    "test:chat-reply": "node --test test/chat-reply.mjs && node test/chat-extras-ui.mjs && node test/chat-composer-ui.mjs",
    "test:profile": "node --test test/profile.mjs",
    "test:feature-media": "node test/feature-media.cjs",
    "test:desktop-features": "node desktop/test-desktop-features.cjs",
    "test:process-capture": "node desktop/test-process-capture.cjs",
    "test:capture-integration": "node desktop/test-capture-integration.mjs",
    "test:ui-features": "node test/ui-features.mjs",
    "test:settings-navigation": "node test/settings-navigation-ui.mjs",
    "test:chat-avatar": "node test/chat-avatar-sync.mjs",
    "test:global-shortcut": "node desktop/test-global-shortcut.cjs",
    "test:shortcut-capture": "node test/global-shortcut.cjs",
    "test:room-sync": "node test/room-sync.cjs",
    "test:workspace": "node --test test/workspace-store.mjs test/room-replica-compat.mjs",
    "test:roles": "node --test test/server-governance.mjs test/server-roles.mjs test/owner-continuity.mjs",
    "test:desktop-workspace": "node test/desktop-workspace-restore.mjs",
    "test:local-interface": "node test/local-interface-native.mjs",
    "test:session-switch": "node test/desktop-session-switch.mjs",
    "vendor:livekit": "node deploy/livekit-bundle.cjs",
    "test:screen-sfu": "node deploy/livekit-test.cjs",
    "typecheck:screen-sfu": "node node_modules/typescript/bin/tsc --project deploy/livekit-typecheck.json",
    "desktop:screen-native": "node tools/build-screen-relay.cjs",
    "test:screen-routing": "node --test test/screen-plan.mjs && node test/screen-routing.cjs",
    "test:screen-ice": "node test/screen-ice.cjs",
    "test:chat-media": "node --test --test-concurrency=1 test/avif-codec.mjs test/media-store.mjs test/room-media.mjs test/chat-media-server.mjs test/sticker-store.mjs test/sticker-panel-order.mjs test/steam-media-storage.mjs test/media-queue.mjs test/steam-media-replicas.mjs",
    "test:content": "node --test test/content-media.mjs test/content-upgrade.mjs test/content-steam.mjs test/room-client.mjs",
    "test:content-native": "node test/content-vault-native.mjs && node test/content-service-native.mjs",
    "test:content-ui": "node test/content-desktop-ui.mjs",
    "test:content-restart": "node test/content-desktop-ui.mjs --forced-restart",
    "test:interface": "node test/interface-scheme.mjs && node test/interface-package.mjs && node test/interface-package-ui.mjs && node test/interface-scheme-editor.mjs && node test/interface-profile.mjs && node test/local-theme-ui.mjs && node test/theme-colors-ui.mjs",
    "test:customization-guides": "node test/customization-guides.mjs && node test/interaction-directory.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "26.6.6",
    "electron": "^45.2.2",
    "hls.js": "1.7.4",
    "livekit-client": "2.23.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "livekit-server-sdk": "2.19.2"
  }
}
