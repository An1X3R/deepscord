{
  "version": 1,
  "id": "industrial-open",
  "name": "工程站·开放主题",
  "description": "完整的本地布局、样式与隔离脚本。固定侧栏、分区工作台和可切换密度。",
  "theme": {
    "accent": "#87d8ce",
    "background": "charcoal",
    "density": "comfortable",
    "corners": "square"
  },
  "interfaceProfile": {
    "version": 1,
    "preset": "industrial",
    "motion": "reduced",
    "navigation": "rail",
    "memberPanel": "expanded"
  },
  "options": [
    {
      "id": "content-spacing",
      "label": "内容间距",
      "type": "range",
      "default": 12,
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "cssVariable": "--scheme-content-spacing"
    },
    {
      "id": "title-scale",
      "label": "标题比例",
      "type": "range",
      "default": 1,
      "min": 0.8,
      "max": 1.4,
      "step": 0.05,
      "unit": "",
      "cssVariable": "--scheme-title-scale"
    }
  ],
  "files": {
    "html": "packages/industrial/layout.html",
    "css": "packages/industrial/style.css",
    "script": "packages/industrial/script.js"
  }
}
