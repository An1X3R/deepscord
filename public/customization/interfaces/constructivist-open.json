{
  "version": 1,
  "id": "constructivist-open",
  "name": "构成报刊·开放主题",
  "description": "《赤楔宣言 · 人们，我们》——窄体工业排印、破界红楔刊头、舒霍夫电塔舞台与纸墨错版叠印，兼顾全功能直达与高对比度阅读。",
  "theme": {
    "accent": "#b6342a",
    "background": "slate",
    "density": "compact",
    "corners": "square"
  },
  "interfaceProfile": {
    "version": 1,
    "preset": "constructivist",
    "motion": "full",
    "navigation": "index",
    "memberPanel": "compact"
  },
  "options": [
    {
      "id": "content-spacing",
      "label": "内容间距",
      "type": "range",
      "default": 16,
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "cssVariable": "--scheme-content-spacing"
    },
    {
      "id": "title-scale",
      "label": "标题比例",
      "type": "range",
      "default": 1.15,
      "min": 0.8,
      "max": 1.4,
      "step": 0.05,
      "unit": "",
      "cssVariable": "--scheme-title-scale"
    },
    {
      "id": "material-mode",
      "label": "纸墨质感",
      "type": "select",
      "default": "print",
      "cssVariable": "--scheme-paper-grain",
      "choices": [
        {
          "value": "print",
          "label": "纸面叠印 (Print Faktura)",
          "cssValue": "1"
        },
        {
          "value": "flat",
          "label": "清晰平涂 (Clean Flat)",
          "cssValue": "0"
        }
      ]
    },
    {
      "id": "construction-rig",
      "label": "尺规建构线",
      "type": "toggle",
      "default": true,
      "on": "1",
      "off": "0",
      "cssVariable": "--scheme-rig-opacity"
    }
  ],
  "files": {
    "html": "packages/constructivist/layout.html",
    "css": "packages/constructivist/style.css",
    "script": "packages/constructivist/script.js"
  }
}
