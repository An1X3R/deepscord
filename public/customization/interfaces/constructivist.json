{
  "version": 1,
  "id": "constructivist",
  "name": "构成主义索引",
  "description": "《为声音 · 凸版画册 1923》——致敬利西茨基模切拇指书签与《艺术主义》正交重型铅条围合，宽幅书籍版心阅读与快速索引抽屉。",
  "theme": {
    "accent": "#bd3528",
    "background": "slate",
    "density": "compact",
    "corners": "square"
  },
  "interfaceProfile": {
    "version": 1,
    "preset": "constructivist",
    "motion": "full",
    "navigation": "index",
    "memberPanel": "compact"
  },
  "options": [
    {
      "id": "content-spacing",
      "label": "内容间距",
      "type": "range",
      "default": 16,
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "cssVariable": "--scheme-content-spacing"
    },
    {
      "id": "title-scale",
      "label": "标题比例",
      "type": "range",
      "default": 1.15,
      "min": 0.8,
      "max": 1.4,
      "step": 0.05,
      "unit": "",
      "cssVariable": "--scheme-title-scale"
    },
    {
      "id": "material-mode",
      "label": "纸墨质感",
      "type": "select",
      "default": "print",
      "cssVariable": "--scheme-paper-grain",
      "choices": [
        {
          "value": "print",
          "label": "活字凸版纸感 (Letterpress)",
          "cssValue": "1"
        },
        {
          "value": "flat",
          "label": "清晰平涂书页 (Clean Sheet)",
          "cssValue": "0"
        }
      ]
    },
    {
      "id": "construction-rig",
      "label": "版心尺规线",
      "type": "toggle",
      "default": true,
      "on": "1",
      "off": "0",
      "cssVariable": "--scheme-rig-opacity"
    }
  ]
}
