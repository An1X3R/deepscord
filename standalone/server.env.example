# Windows start-server.cmd creates server.env with unique credentials on first launch.
# Linux: supply a password and HTTPS through Caddy or your own certificate.
ECHO_NETWORK_MODE=server
ECHO_MEDIA_POLICY=direct
ECHO_SCREEN_MODE=peer-relay
# SFU is a separate service. Enable it only after configuring and starting start-screen-sfu.cmd.
# Run runtime/node.exe deploy/livekit-config.cjs init server.env once to generate server-only keys.
# The public URL points to this room server, never directly to the private LiveKit port.
ECHO_SCREEN_SFU_URL=wss://rooms.example.com/screen-sfu
ECHO_SCREEN_TOKEN_TTL_SECONDS=60
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_NODE_IP=
LIVEKIT_UDP_PORT=7882
LIVEKIT_TCP_PORT=7881
ECHO_PASSWORD=
# Trust only the literal IP addresses of reverse proxies you control, comma separated.
ECHO_TRUSTED_PROXIES=
HTTP_HOST=127.0.0.1
PORT=3000
HTTPS_HOST=::
HTTPS_PORTS=3443
STUN_URLS=
TURN_URL=
TURN_SECRET=
TURN_TTL_SECONDS=
